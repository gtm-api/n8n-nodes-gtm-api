{
  "name": "n8n-nodes-gtm-api",
  "version": "1.0.8",
  "description": "n8n community nodes for gtm-api: LinkedIn outreach actions and webhook triggers on accounts you own, with safety enforced server-side.",
  "keywords": [
    "n8n-community-node-package",
    "linkedin",
    "outreach",
    "gtm-api"
  ],
  "license": "MIT",
  "homepage": "https://gtm-api.com",
  "author": {
    "name": "gtm-api",
    "email": "es@gtm-api.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtm-api/n8n-nodes-gtm-api.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GtmApiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GtmApi/GtmApi.node.js",
      "dist/nodes/GtmApiTrigger/GtmApiTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.5.0"
  }
}
